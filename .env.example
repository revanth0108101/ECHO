# Local-only settings. Keep real values in .env (ignored by Git) or protected platform settings.
NODE_ENV=development
PORT=3000

# Required for persistent local MySQL and Drizzle commands.
DATABASE_URL=

# Manus OAuth/session settings. MANUS_JWT_SECRET is private and server-side only.
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_API_URL=
MANUS_OAUTH_PORTAL_URL=

# Optional platform AI integration. MANUS_API_KEY is private and server-side only.
MANUS_API_URL=
MANUS_API_KEY=

# Optional browser-scoped platform key; never put a private service key here.
MANUS_API_BROWSER_KEY=

# Optional compatibility setting for legacy owner role hints.
OWNER_OPEN_ID=
